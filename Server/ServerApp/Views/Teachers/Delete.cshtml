@model ServerApp.Models.Teacher
@{ Layout = "_Layout"; ViewData["Title"] = "Видалити викладача"; }

<h2>Видалити викладача «@Model.Name»?</h2>
<form method="post" action="/Teachers/Delete">
    <input type="hidden" name="ID" value="@Model.ID" />
    <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
    <a href="/Teachers" class="btn btn-secondary">Скасувати</a>
</form>
