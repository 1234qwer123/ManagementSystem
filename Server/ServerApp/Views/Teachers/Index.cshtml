@model IEnumerable<ServerApp.Models.Teacher>
@{ Layout = "_Layout"; ViewData["Title"] = "Викладачі"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список викладачів</h2>
    <a href="/Teachers/Create" class="btn btn-success">+ Додати викладача</a>
</div>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th><th>ПІБ</th><th>Email</th><th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>
                    <a href="/Teachers/Edit/@item.ID" class="btn btn-sm btn-warning">Змінити</a>
                    <a href="/Teachers/Delete/@item.ID" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
