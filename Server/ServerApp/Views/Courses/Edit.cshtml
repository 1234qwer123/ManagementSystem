@model ServerApp.Models.Course
@{ Layout = "_Layout"; ViewData["Title"] = "Редагувати курс"; }

<h2>Редагування курсу</h2>
<form method="post" action="/Courses/Edit" class="col-md-6">
    <input type="hidden" name="ID" value="@Model.ID" />
    <div class="mb-3">
        <label class="form-label">Назва курсу</label>
        <input name="Name" value="@Model.Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Опис</label>
        <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Викладач</label>
        <select name="TeacherID" class="form-select" required>
            @if (ViewBag.Teachers is IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> items)
            {
                foreach (var item in items)
                {
                    if (item.Selected || item.Value == Model.TeacherID.ToString())
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            }
            else if (ViewBag.Teachers is IEnumerable<ServerApp.Models.Teacher> teachers)
            {
                foreach (var t in teachers)
                {
                    if (t.ID == Model.TeacherID)
                    {
                        <option value="@t.ID" selected>@t.Name</option>
                    }
                    else
                    {
                        <option value="@t.ID">@t.Name</option>
                    }
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Оновити</button>
    <a href="/Courses" class="btn btn-secondary">Скасувати</a>
</form>
