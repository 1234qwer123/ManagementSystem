<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Адмін-панель університету</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/Teachers">Університет | Адмін</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Teachers">Викладачі</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Courses">Курси</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Proposals">Пропозиції</a>
                    </li>
                </ul>
                <a href="/Auth/Logout" class="btn btn-outline-light btn-sm">Вийти</a>
            </div>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
