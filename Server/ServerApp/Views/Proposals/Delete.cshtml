@model ServerApp.Models.Proposal
@{ Layout = "_Layout"; ViewData["Title"] = "Видалити пропозицію"; }

<h2>Видалити пропозицію щодо курсу «@Model.CourseName» (@Model.ProposalType)?</h2>
<form method="post" action="/Proposals/Delete">
    <input type="hidden" name="ID" value="@Model.ID" />
    <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
    <a href="/Proposals" class="btn btn-secondary">Скасувати</a>
</form>
